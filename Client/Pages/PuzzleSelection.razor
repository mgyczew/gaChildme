@using gaChildme.Client.Models

<div class="phase-screen">
    <div class="phase-card">
        <div class="phase-header">
            <h2>Faza 1: Wybierz Obrazek</h2>
            <p class="phase-description">Wybierz obraz do uk³adania puzzli</p>
        </div>

        <div class="image-grid">
            @foreach (var image in Images)
            {
                var isSelected = SelectedImage == image.Path;
                var cls = isSelected ? "image-card selected" : "image-card";
                <button class="@cls" @onclick="() => Select(image.Path)">
                    <div class="image-card-content">
                        <img src="@image.Path" alt="@image.Name" />
                        <p class="image-name">@image.Name</p>
                    </div>
                    @if (isSelected)
                    {
                        <div class="selected-badge">? Wybrano</div>
                    }
                </button>
            }
        </div>

        <button class="btn btn-primary btn-lg next-button" @onclick="Next" disabled="@(SelectedImage==null)">Dalej ?</button>
    </div>
</div>

@code {
    [Parameter] public List<ImageOption> Images { get; set; } = new();
    [Parameter] public EventCallback<string> OnImageSelected { get; set; }

    private string? SelectedImage { get; set; }

    private void Select(string path)
    {
        SelectedImage = path;
    }

    private async Task Next()
    {
        if (SelectedImage != null)
        {
            await OnImageSelected.InvokeAsync(SelectedImage);
        }
    }
}
